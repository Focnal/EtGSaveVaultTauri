{
  "name": "etg-save-vault",
  "productName": "EtG Save Vault",
  "version": "0.1.3",
  "private": true,
  "description": "Enter the Gungeon 存档备份管理工具（Tauri 2）",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "tauri": "tauri",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add src-tauri/Cargo.toml src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
