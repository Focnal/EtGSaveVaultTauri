{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "etg-save-vault",
  "version": "../package.json",
  "identifier": "com.focnal.etgsavevault",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "data": "$DATA/EtG Save Vault"
    },
    "windows": [
      {
        "label": "main",
        "title": "EtG Save Vault",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "backgroundColor": "#101318",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"],
    "publisher": "focnal",
    "copyright": "© 2026 focnal",
    "category": "Utility",
    "shortDescription": "Enter the Gungeon 存档备份管理工具",
    "longDescription": "管理 Enter the Gungeon 存档的多个备份：新建、恢复、回档点、注册表随存档导出导入。"
  }
}
